# Anthropic API
# 現行世代モデルの注意: thinking は既定で有効（パラメータ指定不要）。
# temperature / top_p / top_k / budget_tokens は送ると 400 になるため使わない。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# Slack（Socket Mode 構成）
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxx

# 通知先（既定 DM、必要なら公開チャンネル ID）
SLACK_DEFAULT_CHANNEL=

# データ取得用
KEIBA_DB_PATH=../data/race.db
KEIBA_PLAYBOOKS_DIR=../docs/playbooks
KEIBA_AGENT_PROMPTS_DIR=../.claude/agents
